    "# Path ke odel SavedModel\n",
    "model_path = \"submission/saved_model\"\n",
    "\n",
    "def show_image(predict_img_path):\n",
    "    # Load gambar\n",
    "    img_predict = image.load_img(predict_img_path, target_size=(224, 224))\n",
    "\n",
    "    # Menampilkan gambar input\n",
    "    plt.imshow(img_predict)\n",
    "    plt.axis(\"off\")\n",
    "    plt.title(\"Image Input\")\n",
    "    plt.show()\n",
    "\n",
    "def preprocessing_input_image(predict_img_path):\n",
    "    # Load gambar dan melakukan preprocessing\n",
    "    img_predict = image.load_img(predict_img_path, target_size=(224, 224))\n",
    "\n",
    "    # Mengubah gambar menjadi array\n",
    "    img_array = image.img_to_array(img_predict)\n",
    "\n",
    "    # Melakukan normalisasi\n",
    "    img_array = img_array / 255.0\n",
    "    img_array = np.expand_dims(img_array, axis=0)\n",
    "    img_tensor = tf.constant(img_array, dtype=tf.float32)\n",
    "\n",
    "    return img_tensor\n",
    "\n",
    "# Membuat layer dari model SavedModel\n",
    "model = TFSMLayer(model_path, call_endpoint=\"serving_default\")\n",
    "\n",
    "# Membuat fungsi prediksi\n",
    "def predict_image(predict_img_path):\n",
    "    prediction = model(preprocessing_input_image(predict_img_path))\n",
    "    predicted_class = tf.argmax(prediction['output_0'], axis=1).numpy()[0]\n",
    "\n",
    "    return predicted_class\n",
    "\n",
    "# Mengecek urutan label\n",
    "fruit_labels = train_generator.class_indices\n",
    "\n",
    "# membuat fungsi cek label\n",
    "def check_label(predict_index):\n",
    "    for i, label in enumerate(fruit_labels):\n",
    "        if predict_index == i:\n",
    "            print(\"Result:\", label)\n",
    "            break\n",
    "\n",
    "print(fruit_labels)"
